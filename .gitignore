# Root-level .gitignore
# Covers both backend/ and frontend/ subdirectories

# Dependencies
node_modules/

# Environment secrets — never commit real credentials
.env
.env.local
.env.*.local

# Build output
dist/
dist-ssr/
build/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.sw?
